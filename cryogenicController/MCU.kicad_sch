	(text "Tied to low because we are using\ninternally regulated 1.2V VDD"
		(exclude_from_sim no)
		(at 202.692 69.342 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "0f3d227b-6e88-4d6e-9060-2c410752debe")
	)
	(text "VREFHI is tied to VDDA if ADC is unused\nleave open for internal reference"
		(exclude_from_sim no)
		(at 168.656 106.68 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1a1bc59b-46dc-4697-8831-4691f80c5974")
	)
	(text "Crystal oscillator"
		(exclude_from_sim no)
		(at 51.562 126.238 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1af8ebc1-5306-4c23-8cd5-b6e4fd3ff8f3")
	)
	(text "1206 470nF as a local bulk cap for the whole VDD rail;\n0603 18nF near each power pin to handle fastest current spikes."
		(exclude_from_sim no)
		(at 197.612 26.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "3ecf684c-05ff-4225-8651-f54358acaa2c")
	)
	(text "VDDA Pin requires 2.2 microfarad capacitor.\nQ: Do we need to have all these? \nI have DNP'd 4 of them"
		(exclude_from_sim no)
		(at 210.312 153.924 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "41994b8a-8c0a-4ba4-b866-40e262408939")
	)
	(text "route cleanly and place\nall components near U1"
		(exclude_from_sim no)
		(at 52.324 155.702 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "5af74da7-1383-4f77-a79c-208bdff3699a")
	)
	(text "1.2V, supplied internally\nsince VREGEN is tied to low"
		(exclude_from_sim no)
		(at 163.83 38.608 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9412dede-9938-46b6-ac08-8cfe8cca2cdc")
	)
	(text "BMP1/BMP2 both high (default) = boot from flash\nBMP1 low = SCI/wait boot (recovery)"
